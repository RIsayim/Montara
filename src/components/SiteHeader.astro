---
import RollingText from './RollingText.astro';

const menuItems = [
  { label: 'About', href: '#approach' },
  { label: 'What we do', href: '#services' },
  { label: 'Montara Studio', href: '#studio' },
  { label: 'Projects', href: '#projects' },
  { label: 'Journal', href: '#journal' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header" data-header>
  <a class="wordmark" href="#top" aria-label="Montara home">
    <span class="wordmark__name">MONTARA</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
    <span class="menu-toggle__label">Menu</span>
    <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>

<nav class="primary-navigation" id="primary-navigation" aria-label="Main navigation" aria-hidden="true" inert data-navigation>
    <div class="mega-menu__panel">
      <button class="mega-menu__close" type="button" data-menu-close>
        <span>Close</span>
        <span class="mega-menu__close-icon" aria-hidden="true">&#215;</span>
      </button>
      <aside class="mega-menu__brand" aria-label="Montara">
        <a class="wordmark mega-menu__wordmark" href="#top" aria-label="Montara home">
          <span class="wordmark__name">MONTARA</span>
        </a>
        <p>Light, shade, sound<br />and thoughtful living.</p>
      </aside>

      <div class="mega-menu__content" data-lenis-prevent>
        <div class="mega-menu__links" data-menu-roll-list>
          {menuItems.map((item, index) => (
            <a class:list={[index === 0 && 'is-active']} href={item.href} data-roll-item>
              <RollingText label={item.label} />
            </a>
          ))}
        </div>
      </div>
    </div>
</nav>
